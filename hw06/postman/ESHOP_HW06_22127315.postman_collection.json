{
  "info": {
    "_postman_id": "c73fd2d7-2212-4315-8a06-api-testing-hw06",
    "name": "EShop HW06 API Testing - 22127315",
    "description": "Collection thực thi các test case đại diện Domain Partitions, State Transitions, Security và Schema Validation. Schema suy luận được lưu riêng trong hw06/schemas và phải được audit trước khi nộp.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: pm.environment.get('studentId') || '22127315' });",
          "console.log('HW06 request header:', pm.request.headers.get('X-Student-Id'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Xác thực test accounts",
      "item": [
        {
          "name": "Đăng nhập Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin login: HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Admin login: token hợp lệ', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
            "pm.environment.set('adminToken', body.token);"
          ] } }]
        },
        {
          "name": "Đăng nhập User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" },
            "url": "{{baseUrl}}/api/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('User login: HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('User login: token hợp lệ', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
            "pm.environment.set('userToken', body.token);"
          ] } }]
        }
      ]
    },
    {
      "name": "FR-05 - Listing/search, Domain và Schema",
      "item": [
        {
          "name": "DP-FR05-01 - Danh sách không query",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('FR05 list: HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('FR05 list: Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
            "const products = pm.response.json();",
            "pm.test('SCH-FR05-01: root là array', () => pm.expect(products).to.be.an('array'));",
            "pm.test('SCH-FR05-01: schema item', () => products.forEach(p => { pm.expect(p.id).to.be.a('number'); pm.expect(p.name).to.be.a('string'); pm.expect(p.price).to.be.a('number'); pm.expect(p).to.have.property('description'); pm.expect(p).to.have.property('imageUrl'); pm.expect(p).to.have.property('category_id'); }));",
            "pm.environment.set('baselineProductCount', String(products.length));"
          ] } }]
        },
        {
          "name": "DP-FR05-03 - Search khớp một phần",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products?search=iPhone" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('FR05 search: HTTP 200', () => pm.response.to.have.status(200));",
            "const products = pm.response.json();",
            "pm.test('FR05 search: JSON array', () => pm.expect(products).to.be.an('array'));",
            "pm.test('FR05 search: mọi kết quả chứa từ khóa', () => products.forEach(p => pm.expect(p.name.toLowerCase()).to.include('iphone')));"
          ] } }]
        },
        {
          "name": "DP-FR05-09 - Search không khớp",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products?search=khong-ton-tai-22127315" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('FR05 no-match: HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('SCH-FR05-03: mảng JSON rỗng', () => pm.expect(pm.response.json()).to.be.an('array').and.empty);"
          ] } }]
        },
        {
          "name": "SEC-SQL-01 - SQL injection trong search",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/products?search=%27%20OR%20%271%27%3D%271" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('SQLi: response là JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
            "const products = pm.response.json();",
            "pm.test('SEC-SQL-01: không trả toàn bộ danh sách', () => pm.expect(products.length).to.be.below(Number(pm.environment.get('baselineProductCount'))));"
          ] } }]
        }
      ]
    },
    {
      "name": "FR-08 - Checkout, State và Schema",
      "item": [
        {
          "name": "ST-FR08-01 - Checkout hợp lệ tạo pending order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"total_amount\": 200000,\n  \"shipping_address\": \"123 Lê Lợi, Quận 1, TP.HCM\"\n}" },
            "url": "{{baseUrl}}/api/checkout"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Checkout: HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('SCH-FR08-01: schema checkout success', () => { pm.expect(body.message).to.be.a('string'); pm.expect(body.orderId).to.be.a('number').and.above(0); pm.expect(body).not.to.have.property('error'); });",
            "pm.environment.set('orderId', String(body.orderId));"
          ] } }]
        },
        {
          "name": "ST-FR08-02 - Order history giữ pending",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/orders/my-orders" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Order history: HTTP 200', () => pm.response.to.have.status(200));",
            "const orders = pm.response.json(); const id = Number(pm.environment.get('orderId')); const order = orders.find(o => o.id === id);",
            "pm.test('Order mới tồn tại và pending', () => { pm.expect(order).to.exist; pm.expect(order.status).to.eql('pending'); pm.expect(order.total_amount).to.eql(200000); });"
          ] } }]
        },
        {
          "name": "SCH-FR08-02 - Checkout không token",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"total_amount\": 200000,\n  \"shipping_address\": \"123 Lê Lợi\"\n}" }, "url": "{{baseUrl}}/api/checkout" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Checkout không token: HTTP 401', () => pm.response.to.have.status(401));",
            "pm.test('SCH-FR08-02: schema error', () => { const body = pm.response.json(); pm.expect(body.error).to.be.a('string'); pm.expect(body).not.to.have.property('orderId'); });"
          ] } }]
        },
        {
          "name": "ST-FR08-05 - Hủy pending order",
          "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Cancel pending order: HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('Cancel response có message', () => pm.expect(pm.response.json().message).to.be.a('string'));"
          ] } }]
        }
      ]
    },
    {
      "name": "FR-15 - CRUD, RBAC và Schema",
      "item": [
        {
          "name": "SEC-RBAC-01 - Create product không token bị từ chối",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"HW06 Unauthorized 22127315\",\n  \"price\": 100000,\n  \"description\": \"Security test\",\n  \"imageUrl\": \"https://example.com/p.png\",\n  \"category_id\": 1\n}" }, "url": "{{baseUrl}}/api/products" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('RBAC: không token phải bị từ chối', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));",
            "if (body.id) pm.environment.set('unauthorizedProductId', String(body.id));"
          ] } }]
        },
        {
          "name": "ST-FR15-01 - Admin tạo product",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"HW06 Product 22127315\",\n  \"price\": 100000,\n  \"description\": \"Postman Newman test product\",\n  \"imageUrl\": \"https://example.com/hw06.png\",\n  \"category_id\": 1\n}" }, "url": "{{baseUrl}}/api/products" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin create: HTTP 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('SCH-FR15-01: schema create success', () => { pm.expect(body.message).to.be.a('string'); pm.expect(body.id).to.be.a('number').and.above(0); });",
            "pm.environment.set('productId', String(body.id));"
          ] } }]
        },
        {
          "name": "ST-FR15-02 - Admin cập nhật product",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"HW06 Product Updated 22127315\",\n  \"price\": 120000,\n  \"description\": \"Updated by Newman\",\n  \"imageUrl\": \"https://example.com/hw06-updated.png\",\n  \"category_id\": 1\n}" }, "url": "{{baseUrl}}/api/products/{{productId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin update: HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('SCH-FR15-02: message string', () => pm.expect(pm.response.json().message).to.be.a('string'));"
          ] } }]
        },
        {
          "name": "ST-FR15-05 - Admin xóa product",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/products/{{productId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admin delete: HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('SCH-FR15-03: message string', () => pm.expect(pm.response.json().message).to.be.a('string'));"
          ] } }]
        },
        {
          "name": "Cleanup - Xóa product tạo trái phép nếu có",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/products/{{unauthorizedProductId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Cleanup chỉ chạy khi có product trái phép', () => { const id = pm.environment.get('unauthorizedProductId'); if (id) pm.expect(pm.response.code).to.be.oneOf([200, 404]); else pm.expect(true).to.eql(true); });"
          ] } }]
        }
      ]
    }
  ],
